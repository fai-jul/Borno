<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Ds.BackButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:text"> </item>
        <item name="background">@drawable/bg_back_button</item>
        <item name="backgroundTint">@color/ds_back_button</item>
        <item name="icon">@drawable/ic_back_chevron</item>
        <item name="iconTint">@color/ds_ink_soft</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="rippleColor">@color/ds_sand</item>
    </style>

    <style name="Ds.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/ds_surface</item>
        <item name="boxStrokeColor">@color/ds_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/ds_primary</item>
    </style>

    <style name="Ds.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Ds.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">14sp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/ds_ink</item>
    </style>

    <style name="Ds.Chip.Avatar">
        <item name="android:textSize">28sp</item>
        <item name="chipMinHeight">60dp</item>
        <item name="chipCornerRadius">30dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
    </style>

    <style name="Ds.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Ds.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="Ds.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/ds_surface</item>
        <item name="elevation">12dp</item>
        <item name="itemIconSize">28dp</item>
        <item name="itemPaddingTop">10dp</item>
        <item name="itemPaddingBottom">10dp</item>
        <item name="itemTextAppearanceActive">@style/Ds.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/Ds.NavLabel</item>
        <item name="itemActiveIndicatorStyle">@style/Ds.NavIndicator</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
</resources>
