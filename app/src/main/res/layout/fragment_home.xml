<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_xl">

        <TextView
            android:id="@+id/greeting"
            style="@style/Ds.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_lg" />

        <TextView
            style="@style/Ds.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:text="@string/home_subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xl"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.dyslexiasupport.ui.widget.FeatureCardView
                android:id="@+id/cardRead"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/ds_space_xs"
                android:layout_weight="1"
                app:featureAccent="@color/ds_primary"
                app:featureEmoji="📖"
                app:featureSubtitle="@string/card_read_sub"
                app:featureTitle="@string/card_read_title" />

            <com.dyslexiasupport.ui.widget.FeatureCardView
                android:id="@+id/cardPractice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/ds_space_xs"
                android:layout_weight="1"
                app:featureAccent="@color/ds_mango"
                app:featureEmoji="🎯"
                app:featureSubtitle="@string/card_practice_sub"
                app:featureTitle="@string/card_practice_title" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.dyslexiasupport.ui.widget.FeatureCardView
                android:id="@+id/cardWords"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/ds_space_xs"
                android:layout_weight="1"
                app:featureAccent="@color/ds_plum"
                app:featureEmoji="⭐"
                app:featureSubtitle="@string/card_words_sub"
                app:featureTitle="@string/card_words_title" />

            <com.dyslexiasupport.ui.widget.FeatureCardView
                android:id="@+id/cardScan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/ds_space_xs"
                android:layout_weight="1"
                app:featureAccent="@color/ds_coral"
                app:featureEmoji="📷"
                app:featureSubtitle="@string/card_scan_sub"
                app:featureTitle="@string/card_scan_title" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/ds_space_xl" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Ds.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_share" />
    </LinearLayout>
</ScrollView>
