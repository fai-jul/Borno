<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_xl">

        <TextView
            android:id="@+id/avatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/ds_space_lg"
            android:background="@drawable/bg_emoji_badge"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textSize="52sp" />

        <TextView
            android:id="@+id/name"
            style="@style/Ds.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_lg"
            android:gravity="center"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/role"
            style="@style/Ds.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xs"
            android:gravity="center" />

        <TextView
            android:id="@+id/guestNote"
            style="@style/Ds.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_lg"
            android:background="@drawable/bg_note"
            android:padding="@dimen/ds_space_lg"
            android:text="@string/profile_guest_note"
            android:visibility="gone" />

        <TextView
            style="@style/Ds.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xxl"
            android:text="@string/profile_language" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/langGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            app:selectionRequired="true"
            app:singleSelection="true"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEnglish"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_english" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBangla"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_bangla" />
        </com.google.android.material.chip.ChipGroup>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/ds_space_xl" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Ds.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_logout" />
    </LinearLayout>
</ScrollView>
