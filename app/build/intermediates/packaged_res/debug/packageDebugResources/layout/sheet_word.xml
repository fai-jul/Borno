<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_xl"
        android:paddingTop="@dimen/ds_space_sm"
        android:paddingEnd="@dimen/ds_space_xl"
        android:paddingBottom="@dimen/ds_space_xxl">

        <TextView
            android:id="@+id/wordText"
            style="@style/Ds.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="40sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_lg"
            android:text="@string/word_listen" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveWord"
            style="@style/Ds.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:text="⭐  Save to My Words" />

        <TextView
            android:id="@+id/ttsMessage"
            style="@style/Ds.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            android:background="@drawable/bg_note"
            android:padding="@dimen/ds_space_lg"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstallVoice"
            style="@style/Ds.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:text="@string/word_get_voice"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAssistantWord"
            style="@style/Ds.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ Explain"
            android:contentDescription="@string/assistant_open_cd" />

        <LinearLayout
            android:id="@+id/partsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xl"
            android:orientation="vertical">

            <TextView
                style="@style/Ds.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/word_parts" />

            <TextView
                android:id="@+id/syllableText"
                style="@style/Ds.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:includeFontPadding="true"
                android:textSize="30sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/joinedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xl"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Ds.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/word_joined" />

            <LinearLayout
                android:id="@+id/joinedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
