<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Main app theme (light, warm). Nunito is the English app typeface. -->
    <style name="Theme.DyslexiaSupport" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ds_primary</item>
        <item name="colorOnPrimary">@color/ds_surface</item>
        <item name="colorPrimaryContainer">@color/ds_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ds_on_primary_container</item>
        <item name="colorSecondary">@color/ds_primary</item>
        <item name="colorOnSecondary">@color/ds_ink</item>
        <item name="colorSecondaryContainer">@color/ds_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/ds_ink</item>
        <item name="colorSurface">@color/ds_surface</item>
        <item name="colorOnSurface">@color/ds_ink</item>
        <item name="colorOnSurfaceVariant">@color/ds_ink_soft</item>
        <item name="android:colorBackground">@color/ds_cream</item>
        <item name="android:windowBackground">@color/ds_cream</item>
        <item name="android:navigationBarColor">@color/ds_surface</item>
        <item name="android:statusBarColor">@color/ds_cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="materialButtonStyle">@style/Ds.Button</item>
        <item name="android:windowAnimationStyle">@style/Ds.WindowAnimation</item>
    </style>

    <!-- Splash (Android 12+ SplashScreen API, backported by core-splashscreen) -->
    <style name="Theme.DyslexiaSupport.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ds_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_app_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.DyslexiaSupport</item>
    </style>

    <!-- Base parent style for Ds namespace -->
    <style name="Ds" />

    <style name="Ds.WindowAnimation">
        <item name="android:windowEnterAnimation">@anim/activity_enter</item>
        <item name="android:windowExitAnimation">@anim/activity_exit</item>
        <item name="android:windowShowAnimation">@anim/activity_enter</item>
        <item name="android:windowHideAnimation">@anim/activity_exit</item>
    </style>

    <style name="StreakDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="OnboardingDot">
        <item name="android:layout_width">9dp</item>
        <item name="android:layout_height">9dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_streak_empty</item>
    </style>

    <style name="OnboardingDot.Active" parent="OnboardingDot">
        <item name="android:layout_width">10dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:background">@drawable/bg_streak_done</item>
    </style>

    <style name="StreakDot">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/bg_streak_done</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/ds_surface</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StreakDotEmpty" parent="StreakDot">
        <item name="android:background">@drawable/bg_streak_empty</item>
        <item name="android:textColor">@color/ds_ink_soft</item>
    </style>

    <style name="StreakLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/ds_ink</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BadgeTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="BadgeIcon">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/bg_badge_tile</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="BadgeLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/ds_ink_soft</item>
        <item name="android:textSize">9sp</item>
    </style>

    <!-- Text styles: Nunito for English, Hind Siliguri for Bangla. -->
    <style name="Ds.Text">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textColor">@color/ds_ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Ds.Text.Bangla">
        <item name="android:fontFamily">@font/hind_siliguri</item>
        <item name="android:textColor">@color/ds_ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Ds.Text.Display">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.08</item>
    </style>

    <style name="Ds.Text.Title">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Ds.Text.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ds_ink_soft</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Ds.Text.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ds_ink_soft</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <!-- Buttons: pill shaped, 56dp tall, no ALL CAPS -->
    <style name="Ds.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Ds.TonalButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Ds.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Ds.CompactButton" parent="Ds.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Ds.AuthTitle" parent="Ds.Text.Display">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/ds_ink</item>
    </style>

    <style name="Ds.AuthSubtitle" parent="Ds.Text.Body">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ds_ink_soft</item>
    </style>

    <style name="Ds.AuthLabel" parent="Ds.Text">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ds_ink</item>
    </style>

    <style name="Ds.AuthIconButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">38sp</item>
        <item name="android:textColor">@color/ds_ink</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Ds.AuthPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/ds_auth_primary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Ds.AuthTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ds_auth_primary</item>
    </style>
</resources>
