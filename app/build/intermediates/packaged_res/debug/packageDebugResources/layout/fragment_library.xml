<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/Ds.Text.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ds_space_xl"
        android:paddingTop="@dimen/ds_space_lg"
        android:paddingEnd="@dimen/ds_space_xl"
        android:text="@string/nav_read" />

    <TextView
        style="@style/Ds.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ds_space_xl"
        android:paddingTop="@dimen/ds_space_xs"
        android:paddingEnd="@dimen/ds_space_xl"
        android:text="@string/library_subtitle" />

    <!-- Row 1: language + saved -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_md"
        android:clipToPadding="false"
        android:paddingStart="@dimen/ds_space_xl"
        android:paddingEnd="@dimen/ds_space_xl"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/langGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLangAll"
                    style="@style/Ds.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLangBn"
                    style="@style/Ds.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_bn_label" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLangEn"
                    style="@style/Ds.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_en_label" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSaved"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_sm"
                android:text="@string/chip_saved" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Row 2: level -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/ds_space_xl"
        android:paddingEnd="@dimen/ds_space_xl"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/levelGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLevelAll"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_levels_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLevel1"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_level_1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLevel2"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_level_2" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLevel3"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_level_3" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <TextView
        style="@style/Ds.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ds_space_xl"
        android:paddingTop="@dimen/ds_space_xs"
        android:paddingEnd="@dimen/ds_space_xl"
        android:paddingBottom="@dimen/ds_space_xs"
        android:text="@string/library_swipe_hint" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/ds_space_xl"
            android:paddingTop="@dimen/ds_space_xs"
            android:paddingEnd="@dimen/ds_space_xl"
            android:paddingBottom="@dimen/ds_space_lg" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_xl"
            android:visibility="gone">

            <TextView
                style="@style/Ds.Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="📚"
                android:textSize="56sp" />

            <TextView
                android:id="@+id/emptyText"
                style="@style/Ds.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_md"
                android:gravity="center" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
