<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_xl">

        <TextView
            style="@style/Ds.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_lg"
            android:text="@string/register_title" />

        <TextView
            style="@style/Ds.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:text="@string/register_subtitle" />

        <TextView
            style="@style/Ds.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xl"
            android:text="@string/label_avatar" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/avatarGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAv1"
                style="@style/Ds.Chip.Avatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="🐼" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAv2"
                style="@style/Ds.Chip.Avatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐯" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAv3"
                style="@style/Ds.Chip.Avatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐰" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAv4"
                style="@style/Ds.Chip.Avatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐶" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAv5"
                style="@style/Ds.Chip.Avatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐱" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAv6"
                style="@style/Ds.Chip.Avatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐸" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            style="@style/Ds.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xl"
            android:text="@string/label_role" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/roleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRoleChild"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/role_child" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRoleLearner"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/role_learner" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRoleParent"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/role_parent" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRoleTeacher"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/role_teacher" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutName"
            style="@style/Ds.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xl"
            android:hint="@string/hint_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                android:textSize="18sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutEmail"
            style="@style/Ds.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            android:hint="@string/hint_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:textSize="18sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPassword"
            style="@style/Ds.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            android:hint="@string/hint_password"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:textSize="18sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xl"
            android:text="@string/action_create_account" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHaveAccount"
            style="@style/Ds.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:text="@string/register_have_account" />
    </LinearLayout>
</ScrollView>
