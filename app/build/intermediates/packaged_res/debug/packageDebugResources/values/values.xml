    <style name="Ds"/>
    <style name="Ds.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/ds_surface</item>
        <item name="itemTextAppearanceActive">@style/Ds.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/Ds.NavLabel</item>
        <item name="itemActiveIndicatorStyle">@style/Ds.NavIndicator</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    <style name="Ds.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">28dp</item>
    </style>
    <style name="Ds.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">16sp</item>
        <item name="chipMinHeight">48dp</item>
        <item name="chipCornerRadius">24dp</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="android:textColor">@color/ds_ink</item>
    </style>
    <style name="Ds.Chip.Avatar">
        <item name="android:textSize">28sp</item>
        <item name="chipMinHeight">60dp</item>
        <item name="chipCornerRadius">30dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
    </style>
    <style name="Ds.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/ds_primary_container</item>
    </style>
    <style name="Ds.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/hind_siliguri</item>
    </style>
    <style name="Ds.Text">
        <item name="android:fontFamily">@font/hind_siliguri</item>
        <item name="android:textColor">@color/ds_ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Ds.Text.Body">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ds_ink_soft</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="Ds.Text.Caption">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ds_ink_soft</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="Ds.Text.Display">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="Ds.Text.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Ds.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Ds.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">@color/ds_surface</item>
        <item name="boxStrokeColor">@color/ds_primary</item>
        <item name="hintTextColor">@color/ds_primary</item>
    </style>
    <style name="Ds.TonalButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">28dp</item>
    </style>
    <style name="Theme.DyslexiaSupport" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ds_primary</item>
        <item name="colorOnPrimary">@color/ds_surface</item>
        <item name="colorPrimaryContainer">@color/ds_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ds_on_primary_container</item>
        <item name="colorSecondary">@color/ds_mango</item>
        <item name="colorOnSecondary">@color/ds_ink</item>
        <item name="colorSecondaryContainer">@color/ds_sand</item>
        <item name="colorOnSecondaryContainer">@color/ds_ink</item>
        <item name="colorSurface">@color/ds_surface</item>
        <item name="colorOnSurface">@color/ds_ink</item>
        <item name="colorOnSurfaceVariant">@color/ds_ink_soft</item>
        <item name="android:colorBackground">@color/ds_cream</item>
        <item name="android:windowBackground">@color/ds_cream</item>
        <item name="android:fontFamily">@font/hind_siliguri</item>
        <item name="fontFamily">@font/hind_siliguri</item>
        <item name="materialButtonStyle">@style/Ds.Button</item>
    </style>
    <style name="Theme.DyslexiaSupport.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ds_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.DyslexiaSupport</item>
    </style>
    <declare-styleable name="FeatureCardView">
        <attr format="string" name="featureTitle"/>
        <attr format="string" name="featureSubtitle"/>
        <attr format="string" name="featureEmoji"/>
        <attr format="color" name="featureAccent"/>
    </declare-styleable>
</resources>