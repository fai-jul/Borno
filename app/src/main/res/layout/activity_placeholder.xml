<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_cream"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/ds_space_xl">

    <TextView
        style="@style/Ds.Text.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:text="🚧" />

    <TextView
        android:id="@+id/placeholderTitle"
        style="@style/Ds.Text.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_lg" />

    <TextView
        style="@style/Ds.Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:text="@string/coming_soon" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_xl"
        android:minWidth="200dp"
        android:text="@string/action_back" />
</LinearLayout>
