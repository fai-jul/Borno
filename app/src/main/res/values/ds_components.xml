<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Ds.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">@color/ds_surface</item>
        <item name="boxStrokeColor">@color/ds_primary</item>
        <item name="hintTextColor">@color/ds_primary</item>
    </style>

    <style name="Ds.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Ds.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">16sp</item>
        <item name="chipMinHeight">48dp</item>
        <item name="chipCornerRadius">24dp</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="android:textColor">@color/ds_ink</item>
    </style>

    <style name="Ds.Chip.Avatar">
        <item name="android:textSize">28sp</item>
        <item name="chipMinHeight">60dp</item>
        <item name="chipCornerRadius">30dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
    </style>

    <style name="Ds.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/hind_siliguri</item>
    </style>

    <style name="Ds.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/ds_primary_container</item>
    </style>

    <style name="Ds.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/ds_surface</item>
        <item name="itemTextAppearanceActive">@style/Ds.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/Ds.NavLabel</item>
        <item name="itemActiveIndicatorStyle">@style/Ds.NavIndicator</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
</resources>
