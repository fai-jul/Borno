<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_ink">

    <!-- ===== Step 1: camera ===== -->
    <FrameLayout
        android:id="@+id/panelCamera"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            style="@style/Ds.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center"
            android:paddingStart="72dp"
            android:paddingTop="@dimen/ds_space_lg"
            android:paddingEnd="72dp"
            android:text="@string/scan_hint_camera"
            android:textColor="@color/ds_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Ds.BackButton"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/ds_space_md"
            android:contentDescription="@string/scan_close_cd"
            android:text="" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGallery"
            style="@style/Ds.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="@dimen/ds_space_xl"
            android:layout_marginBottom="@dimen/ds_space_xl"
            android:contentDescription="@string/scan_gallery_cd"
            android:minWidth="56dp"
            android:text="🖼" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCapture"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/ds_space_xl"
            android:backgroundTint="@color/ds_surface"
            android:contentDescription="@string/scan_capture_cd"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="38dp"
            app:strokeColor="@color/ds_mango"
            app:strokeWidth="5dp" />

        <!-- Shown when the camera permission was refused -->
        <LinearLayout
            android:id="@+id/permissionView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ds_ink"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_xl"
            android:visibility="gone">

            <TextView
                style="@style/Ds.Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="📷"
                android:textSize="56sp" />

            <TextView
                style="@style/Ds.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_md"
                android:gravity="center"
                android:text="@string/scan_permission_title"
                android:textColor="@color/ds_surface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAllowCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_xl"
                android:text="@string/scan_allow_camera" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSettings"
                style="@style/Ds.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:text="@string/scan_open_settings" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Step 2: crop ===== -->
    <LinearLayout
        android:id="@+id/panelCrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/Ds.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/ds_space_md"
            android:text="@string/scan_crop_hint"
            android:textColor="@color/ds_surface" />

        <com.dyslexiasupport.ui.scan.CropImageView
            android:id="@+id/cropView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="@dimen/ds_space_md" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/ds_space_lg">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetake"
                style="@style/Ds.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ds_space_sm"
                android:layout_weight="1"
                android:text="@string/scan_retake" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReadText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_sm"
                android:layout_weight="1"
                android:text="@string/scan_read_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Step 3: edit ===== -->
    <LinearLayout
        android:id="@+id/panelEdit"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_cream"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_xl">

                <TextView
                    style="@style/Ds.Text.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_edit_title"
                    android:textSize="28sp" />

                <TextView
                    style="@style/Ds.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    android:text="@string/scan_edit_hint" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Ds.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_lg"
                    android:hint="@string/scan_field_title">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textSize="18sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Ds.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_md"
                    android:hint="@string/scan_field_body">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:lineSpacingMultiplier="1.4"
                        android:minLines="10"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/ds_space_lg">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddPage"
                style="@style/Ds.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ds_space_sm"
                android:layout_weight="1"
                android:text="@string/scan_add_page" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_sm"
                android:layout_weight="1"
                android:text="@string/scan_save" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Busy overlay ===== -->
    <LinearLayout
        android:id="@+id/progressOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC1B1A22"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/ds_mango" />

        <TextView
            style="@style/Ds.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_lg"
            android:text="@string/scan_working"
            android:textColor="@color/ds_surface" />
    </LinearLayout>
</FrameLayout>
