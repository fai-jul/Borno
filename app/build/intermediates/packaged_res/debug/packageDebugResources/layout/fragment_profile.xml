<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_xl">

        <TextView
            android:id="@+id/avatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/ds_space_lg"
            android:background="@drawable/bg_emoji_badge"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textSize="52sp" />

        <TextView
            android:id="@+id/name"
            style="@style/Ds.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_lg"
            android:gravity="center"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/role"
            style="@style/Ds.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xs"
            android:gravity="center" />

        <TextView
            android:id="@+id/guestNote"
            style="@style/Ds.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_lg"
            android:background="@drawable/bg_note"
            android:padding="@dimen/ds_space_lg"
            android:text="@string/profile_guest_note"
            android:visibility="gone" />

        <TextView
            style="@style/Ds.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xl"
            android:text="@string/profile_language" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/langGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            app:selectionRequired="true"
            app:singleSelection="true"
            >

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEnglish"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_english" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBangla"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_bangla" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xl"
            app:cardBackgroundColor="@color/ds_surface"
            app:cardCornerRadius="@dimen/ds_radius_lg"
            app:cardElevation="0dp"
            app:strokeColor="@color/ds_sand"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="@dimen/ds_space_lg">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Ds.Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_theme_title" />

                    <TextView
                        style="@style/Ds.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_xs"
                        android:text="@string/profile_theme_subtitle" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/action_toggle_theme"
                    android:text="@string/profile_theme_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAssessment"
            style="@style/Ds.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_lg"
            android:text="@string/profile_assessment" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPracticeControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_lg"
            app:cardBackgroundColor="@color/ds_surface"
            app:cardCornerRadius="@dimen/ds_radius_lg"
            app:cardElevation="0dp"
            app:strokeColor="@color/ds_sand"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_lg">

                <TextView
                    style="@style/Ds.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_controls_title" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutDailyGoal"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_sm"
                    android:hint="@string/profile_daily_goal_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editDailyGoal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/dailyGoalModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    app:singleSelection="true"
                    app:selectionRequired="true">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipGoalMinutes"
                        style="@style/Ds.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_goal_minutes" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipGoalExercises"
                        style="@style/Ds.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_goal_exercises" />
                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAssistant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_assistant_enabled" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchReadingOnly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_reading_only" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Parent / Teacher Link Code Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLinkCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_lg"
            app:cardBackgroundColor="@color/ds_surface"
            app:cardCornerRadius="@dimen/ds_radius_lg"
            app:cardElevation="2dp"
            app:strokeColor="@color/ds_sand"
            app:strokeWidth="1dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_lg">

                <TextView
                    style="@style/Ds.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/link_code_section_title" />

                <!-- Student/Learner View: Shows Code & Copy Button -->
                <LinearLayout
                    android:id="@+id/layoutLearnerCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textLinkCode"
                        style="@style/Ds.Text.Display"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/ds_primary"
                        android:textSize="22sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyCode"
                        style="@style/Ds.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/link_code_copy" />
                </LinearLayout>

                <!-- Parent/Teacher View: Input Link Code & Button -->
                <LinearLayout
                    android:id="@+id/layoutParentLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_sm"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutLinkCode"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/link_code_enter_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editLinkCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLinkStudent"
                        style="@style/Ds.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_sm"
                        android:text="@string/link_code_button" />

                    <TextView
                        android:id="@+id/textLinkedCount"
                        style="@style/Ds.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_xs"
                        android:textColor="@color/ds_primary" />

                    <!-- Role-Specific Action Buttons for Parent/Teacher -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewChildProgress"
                        style="@style/Ds.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_md"
                        android:text="@string/btn_view_child_progress"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutTeacherActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_md"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClassReportPdf"
                            style="@style/Ds.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_class_report_pdf" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAssignNctb"
                            style="@style/Ds.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_sm"
                            android:text="@string/btn_assign_nctb" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cloud Sync Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            app:cardBackgroundColor="@color/ds_surface"
            app:cardCornerRadius="@dimen/ds_radius_lg"
            app:cardElevation="2dp"
            app:strokeColor="@color/ds_sand"
            app:strokeWidth="1dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ds_space_lg">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Ds.Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sync_status_title" />

                    <TextView
                        android:id="@+id/textSyncStatus"
                        style="@style/Ds.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sync_status_synced"
                        android:textColor="@color/ds_ink_soft" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSyncNow"
                    style="@style/Ds.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_now_btn" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Low-End Device Mode Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            app:cardBackgroundColor="@color/ds_surface"
            app:cardCornerRadius="@dimen/ds_radius_lg"
            app:cardElevation="2dp"
            app:strokeColor="@color/ds_sand"
            app:strokeWidth="1dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ds_space_lg">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Ds.Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/low_end_title" />

                    <TextView
                        style="@style/Ds.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/low_end_desc"
                        android:textColor="@color/ds_ink_soft" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchLowEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_sm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/ds_space_xl" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Ds.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ds_space_sm"
            android:text="@string/action_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Ds.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_logout" />
    </LinearLayout>
</ScrollView>
