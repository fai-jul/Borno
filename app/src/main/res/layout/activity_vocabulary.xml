<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_cream"
    android:orientation="vertical">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/ds_space_md"
        android:paddingTop="@dimen/ds_space_md"
        android:paddingBottom="@dimen/ds_space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Ds.BackButton"
            android:contentDescription="@string/action_back"
            android:text="" />

        <TextView
            style="@style/Ds.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_xs"
            android:layout_weight="1"
            android:text="@string/card_words_title"
            android:textColor="@color/ds_ink" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddWord"
            style="@style/Ds.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingHorizontal="16dp"
            android:text="+  Add"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFlashcards"
            style="@style/Ds.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/ds_space_xs"
            android:text="Cards"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Search Input Box -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Ds.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_space_md"
        android:layout_marginVertical="@dimen/ds_space_xs"
        android:hint="Search words...">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/hind_siliguri"
            android:inputType="text"
            android:textColor="@color/ds_ink"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/ds_space_md"
        android:paddingVertical="@dimen/ds_space_xs"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/chip_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSaved"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_saved" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBangla"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_bangla" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEnglish"
                style="@style/Ds.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_english" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listWords"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingBottom="@dimen/ds_space_lg" />

        <TextView
            android:id="@+id/textEmpty"
            style="@style/Ds.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/ds_space_xl"
            android:text="No words found."
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
